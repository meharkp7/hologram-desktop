{
    "manifest_version": 3,
    "name": "Holographic Hand Control",
    "version": "1.0",
    "description": "Touchless desktop control via hand gestures",
    "permissions": ["activeTab", "scripting"],
    "action": {
      "default_popup": "index.html",
      "default_icon": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
      }
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["contentScript.js"]
      }
    ]
  }  